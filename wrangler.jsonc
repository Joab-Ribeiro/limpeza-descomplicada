// Configuração da Cloudflare (Workers com arquivos estáticos).
// O "name" precisa ser igual ao nome do projeto no painel da Cloudflare.
{
  "name": "limpeza-descomplicada",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
